padding:10px 25px 10px 10px; 
margin: 5px; 
background-color: #fdf2f0;
border-left-width: 10px;
color: #a41b12; 
position: relative;
display: none; 
} 
.alert-dismissable { 
padding-right: 5%; 
} 
.row { 
display: flex; 
flex-wrap: wrap; 
} 
.text { 
