                </td>
                                                                                                                                            <td headers="view-field-copies-to-court-table-column--2" class="views-field views-field-field-copies-to-court">                </td>
                                                                                                                                            <td headers="view-body-table-column--2" class="views-field views-field-body"><p><span>Use this form if you are an attorney and wish to apply to the Appointed Attorneys Program. </span><a href="/district/appointedattorneys"><span>Learn more</span></a><span>.</span></p>                </td>
                    </tr>
            <tr>
                                                                                                                                            <td headers="view-field-form-document-1-table-column--2" class="views-field views-field-field-form-document-1"><a href="/sites/default/files/court-forms/district/forms/general/dc099.pdf/dc099.pdf">DC-099 </a>                </td>
