<link href="/core/themes/default/assets/stylesheets/screen.css" media="screen" rel="stylesheet" />
<script src="/core/themes/default/assets/javascripts/all.js" type="e98a3f26c0adb49d2589802c-text/javascript"></script>

<script nonce="" type="e98a3f26c0adb49d2589802c-text/javascript">
	const showAllLinks = document.querySelectorAll('.filter-row-show-all');
	const showLessLinks = document.querySelectorAll('.filter-row-show-less');

	showAllLinks.forEach(el => {
		el.addEventListener("click", function(){
			document.getElementById(el.dataset.filter + '-more-container').style.display = 'block';
			el.style.display = 'none';
		});
	});

	showLessLinks.forEach(el => {
		el.addEventListener("click", function(){
			document.getElementById(el.dataset.filter + '-more-container').style.display = 'none';
			document.getElementById(el.dataset.filter + '-show-all').style.display = null;
		});
	});
</script>

