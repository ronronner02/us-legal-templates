    <span id="page-body"></span>
    <div id="maincontent1" class="article" role="main"> <!-- InstanceBeginEditable name="maincontent2" -->
     <ul class="breadcrumb">
  <li><a href="https://www.maine.gov/labor/">Home</a></li>
 <li><strong>Labor Posters</strong></li></ul>
      <h1>Labor Posters</h1>
      <p>These  are posters which  are required and optional for the Maine workplace.&nbsp; It is our  objective to make these posters as easily available for the workplace as  possible. You may download and print them from this page. Additionally free  printed copies of the Maine posters are available by contacting us at (207)  623-7900 or by contacting us with your name, address, and request using the <a href="https://www.maine.gov/labor/contact/" target="_blank">Contact Us</a> link at the top of the  page.&nbsp; Be sure to request specific languages if needed.&nbsp; </p>
<h2>State of Maine Required Posters</h2>
     <div class="row">
       <div class="column">  
                <button class="accordion"><strong>Child Labor Posters</strong></button>
                <div class="panel">
                  <p><strong>Telephone: Maine Department of Labor 623-7900</strong></p>
                  <ul>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_Arabic_Final.pdf" target="_blank">ملصق حول عمالة الأطفالة</a> - Arabic Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_Chinese_Final.pdf" target="_blank">童工海报</a> - Chinese Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_English.pdf" target="_blank">English Language Poster</a>&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_French.pdf" target="_blank">Affiche sur le travail des enfants</a>&nbsp;- French Language Poster&nbsp;(PDF)</li>
                    <li><a href="../docs/2026/posters/mainerequiredposters/childlabor_LN.pdf" target="_blank">Affiche ya mosala ya bana</a> - Lingala Language Poster (PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_Portuguese.pdf" target="_blank">Cartaz sobre o Trabalho Infantil</a>&nbsp;- Portuguese Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_Somali.pdf" target="_blank">Boodhka Foosha Carruurta</a> - Somali Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/childlabor/childlabor_Spanish.pdf" target="_blank">Cartel sobre el trabajo infantil</a> - Spanish Language Poster&nbsp;(PDF)</li>
                  </ul>
                </div>
                <p></p>
          
          <button class="accordion"><strong>Minimum Wage Posters</strong></button>
                <div class="panel">
                  <p><strong>Telephone: Maine Department of Labor 623-7900</strong></p>
                  <p><strong>Posters for 2026 (effective January 1, 2026)</strong></p>
					<ul>
					  <li><a href="../docs/2026/posters/minwage/Arabic_minimum_wage.pdf" target="_blank">ملصق الحد الأدنى للأجور</a>&nbsp; - Arabic Language Poster (PDF)</li>
  <li><a href="../docs/2026/posters/minwage/Chinese_minimum_wage.pdf" target="_blank">最低工资海报</a>&nbsp;- Chinese Language Poster (PDF)</li>
  <li><a href="../docs/2026/posters/minwage/English_minimum_wage.pdf" target="_blank">English Language Poster</a> (PDF)</li>
  <li><a href="../docs/2026/posters/minwage/French_minimum_wage.pdf" target="_blank">Affiche sur le salaire minimum</a>- French Language Poster&nbsp;(PDF)</li>
  <li><a href="../docs/2026/posters/mainerequiredposters/LN_minimum_wage.pdf" target="_blank">Affiche ya Lifuta ya Moke</a> - Lingala Language Poster (PDF)</li>
  <li><a href="../docs/2026/posters/minwage/Portuguese_minimum_wage.pdf" target="_blank">Cartaz do Salário Mínimo</a>&nbsp;- Portuguese Language Poster&nbsp;(PDF)</li>
  <li><a href="../docs/2026/posters/minwage/Somali_minimum_wage.pdf" target="_blank">Boodhka Mushaharka Ugu Yar</a>&nbsp;- Somali Language Poster&nbsp;(PDF)</li>
  <li><a href="../docs/2026/posters/minwage/Spanish_minimum_wage.pdf" target="_blank">Cartel del salario mínimo</a>&nbsp;- Spanish Language Poster&nbsp;(PDF)</li>
  </ul>
					<p><strong>Posters for 2027 (effective January 1, 2027)</strong></p>
					<ul>
					 <li><a href="../docs/2027/posters/Arabic_minimum_wage.pdf" target="_blank">ملصق الحد الأدنى للأجور</a>&nbsp; - Arabic Language Poster (PDF)</li>
					  <li><a href="../docs/2027/posters/Chinese_minimum_wage.pdf" target="_blank">最低工资海报</a>&nbsp;- Chinese Language Poster (PDF)</li>
					  <li><a href="../docs/2027/posters/English_minimum_wage.pdf" target="_blank">English Language Poster</a> (PDF)</li>
					  <li><a href="../docs/2027/posters/French_minimum_wage.pdf" target="_blank">Affiche sur le salaire minimum</a>- French Language Poster&nbsp;(PDF)</li>
					  <li><a href="../docs/2027/posters/Lingala_minimum_wage.pdf" target="_blank">Affiche ya Lifuta ya Moke</a> - Lingala Language Poster (PDF)</li>
					  <li><a href="../docs/2027/posters/Portuguese_minimum_wage.pdf" target="_blank">Cartaz do Salário Mínimo</a>&nbsp;- Portuguese Language Poster&nbsp;(PDF)</li>
					  <li><a href="../docs/2027/posters/Somali_minimum_wage.pdf" target="_blank">Boodhka Mushaharka Ugu Yar</a>&nbsp;- Somali Language Poster&nbsp;(PDF)</li>
					  <li><a href="../docs/2027/posters/Spanish_minimum_wage.pdf" target="_blank">Cartel del salario mínimo</a>&nbsp;- Spanish Language Poster&nbsp;(PDF)          </li>
				  </ul>
          </div>
                <p></p>
          
         
          
          <button class="accordion"><strong>Regulation of Employment Posters</strong></button>
          <div class="panel">
            <p><strong>Telephone: </strong><strong>Maine Department of Labor 623-7900</strong>            </p>
            <ul>
            <li>              <a href="../docs/2024/posters/regofemployment/regulationofemployment_Arabic_Final.pdf" target="_blank">ملصق تنظيم التوظيف</a>&nbsp;- Arabic Language Poster&nbsp;(PDF)</li>
            <li><a href="../docs/2024/posters/regofemployment/regulationofemployment_Chinese_Final.pdf" target="_blank">就业法规海报</a> - Chinese Language Poster&nbsp;(PDF)</li>
            <li><a href="../docs/2024/posters/regofemployment/regulationofemployment_English.pdf" target="_blank">English Language Poster</a>&nbsp;(PDF)</li>
            <li><a href="../docs/2026/posters/mainerequiredposters/regulationofemployment_LN.pdf" target="_blank">Affiche sur la réglementation de l'emploi</a>&nbsp;- French Language Poster&nbsp;(PDF)</li>
            <li><a href="../docs/2026/posters/mainerequiredposters/regulationofemployment_LN.pdf" target="_blank">Affiche ya réglementation ya emploi</a> - Lingala Language Poster (PDF)</li>
            <li><a href="../docs/2024/posters/regofemployment/regulationofemployment_Portuguese_Final.pdf" target="_blank">Cartaz sobre Regulamentação do Emprego</a>&nbsp;- <br>
              Portuguese Language Poster&nbsp;(PDF)</li>
            <li><a href="../docs/2024/posters/regofemployment/Regulationofemployment_Somali_Final.pdf" target="_blank">Xeerka Boodhka Shaqada</a>- Somali Language Poster&nbsp;(PDF)</li>
            <li><a href="../docs/2024/posters/regofemployment/Regulationofemployment_Spanish_Final.pdf" target="_blank">Cartel sobre la normativa laboral</a>&nbsp; - Spanish Language Poster&nbsp;(PDF)</li>
            </ul>
          </div>
                <p></p>
          
          <button class="accordion"><strong>Whistle Blower Posters</strong></button>
          <div class="panel">
            <p><strong>Telephone: </strong><strong>Maine Department of Labor 623-7900</strong></p>
            <ul>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_Arabic.pdf" target="_blank">ملصق المبلغين عن المخالفات </a> - Arabic Language Poster&nbsp;(PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_Chinese.pdf" target="_blank">吹哨人海报</a> - Chinese Language Poster&nbsp;(PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_English.pdf" target="_blank">English Language Poster</a>&nbsp;(PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_French.pdf" target="_blank">Affiche sur les lanceurs d'alerte</a>&nbsp;- French Language Poster&nbsp;(PDF)</li>
              <li><a href="../docs/2026/posters/mainerequiredposters/whistleblowerprotection_LN.pdf" target="_blank">Affiche ya mopesi sango</a> - Lingala Language Poster (PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_Portuguese.pdf" target="_blank">Cartaz sobre Denúncias</a>&nbsp;- Portuguese Language Poster&nbsp;(PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_Somali.pdf" target="_blank">Boodhka foorida</a>&nbsp;- Somali Language Poster&nbsp;(PDF)</li>
              <li><a href="https://www.maine.gov/labor/docs/2022/posters/whistleblower/whistleblowerprotection_spanish.pdf" target="_blank">Cartel para denunciantes</a> - Spanish Language Poster&nbsp;(PDF)</li>
            </ul>
          </div>
      <p></p>  
      <button class="accordion"><strong>Workers Compensation Poster</strong></button>
          <div class="panel">
            <p><strong>Maine Workers' Compensation Comm. 287-3751</strong></p>
            <ul>
              <li><a href="https://www.maine.gov/wcb/forms/index.html" target="_blank">WCB-90 - Workers' Compensation Board Notice to Employees  English/French/Spanish  Poster&nbsp;(PDF)</a></li>
            </ul>
          </div>
      <p></p> 
		   <button class="accordion"><strong>Paid Family and Medical Leave</strong></button>
          <div class="panel">
            <ul>
              <li><a href="../docs/2025/posters/pfml/englishposter.pdf" target="_blank">Paid Familiy and Medical Leave  Poster</a>&nbsp;- English&nbsp;(PDF)</li>
              <li><a href="../docs/2025/posters/pfml/frenchposter.pdf" target="_blank">Affiche sur les congés familiaux et médicaux payés</a>&nbsp;- French (PDF)</li>
              <li><a href="../docs/2025/posters/pfml/portugueseposter.pdf" target="_blank">Cartaz sobre baixa médica e familiar remunerada</a>&nbsp;- Portuguese (PDF)</li>
              <li><a href="../docs/2025/posters/pfml/somaliposter.pdf" target="_blank">Boodhadhka Fasaxa Qoyska iyo Caafimaadka ee Lacag-bixinta ah</a>&nbsp;- Somali (PDF)</li>
              <li><a href="../docs/2025/posters/pfml/spanishposter.pdf" target="_blank">Póster sobre licencia familiar y médica remunerada</a> - Spanish (PDF)</li>
            </ul>
          </div>
      <p></p>  
		   <button class="accordion"><strong>Right Not to Participate in Employers’ Religious or Political Meetings</strong></button>
          <div class="panel">
            <p>The Maine Department of Labor  does not have enforcement authority related to this law. If your rights are  violated, you may file a civil lawsuit in Maine Superior Court. You have 90  days from the date of the violation to file. A court may order that: you be  rehired, if you were fired; the employer pay you back wages and/or restore your  benefits/seniority; the employer stop the violations; and other remedies.</p>
            <ul>
              <li><a href="../docs/2026/posters/26MRSA600_BPoster.pdf" target="_blank">Right Not to Participate in Employers’ Religious or Political Meetings</a>&nbsp;(PDF)</li>
            </ul>
          </div>
      <p></p>         
        </div>
  <div class="column">   
               
              <button class="accordion"><strong>Maine Employment Security Law Posters</strong></button>
                <div class="panel">
                  <p><strong>Telephone: Maine Department of Labor 621-5100</strong></p>
                  <ul>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/mesl/Maine%20Employment%20Security%20Law_11-19_Arabic_Final.pdf" target="_blank">ملصق قانون أمن التوظيف في ولاية مين</a> - Arabic Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/mesl/Maine%20Employment%20Security%20Law_11-19_Chinese_Final.pdf" target="_blank">缅�&nbsp;州就业保障法海报</a> - Chinese Language Poster&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/mesl/Maine%20Employment%20Security%20Law_11-19_English.pdf" target="_blank">English Language Poster</a>&nbsp;(PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/mesl/Maine%20Employment%20Security%20Law_11-19_French.pdf" target="_blank">Affiche relative �&nbsp; la loi sur la sécurité de l'emploi du Maine</a>&nbsp;- <br>
                    French Language Poster&nbsp;(PDF)</li>
                    <li><a href="../docs/2026/posters/mainerequiredposters/MaineEmploymentSecurityLaw_LN.pdf" target="_blank">Affiche ya mibeko ya bokengi ya mosala ya Maine</a> - <br>
                    Lingala Language Poster (PDF)</li>
                    <li><a href="https://www.maine.gov/labor/docs/2022/posters/mesl/Maine%20Employment%20Security%20Law_11-19_Portuguese.pdf" target="_blank">Cartaz da Lei de Segurança no Emprego do Maine</a>&nbsp;- <br>
                    Portuguese Language Poster&nbsp;(PDF)</li>
