          </section>
                  <section id="section1788-6" role="tabpanel" aria-labelledby="tab1788-6" class="tabs-panel js-tabs-panel" tabindex="0">

            <div class="accordion-trigger js-accordion-trigger" aria-controls="section1788-6" aria-expanded="true" tabindex="0">
              District Specific Resources

            </div>

            <div class="content" aria-hidden="false">
                <div class="paragraph paragraph--type--a11y-paragraphs-tabs-panel paragraph--view-mode--default">
          
              <div class="field field--name-field-a11y-para-tabs-tab-content field--type-entity-reference-revisions field--label-hidden field__item"><div class="field-inner">  <div class="paragraph paragraph--type--a11y-paragraphs-tab-content paragraph--view-mode--default">
          
              <div class="clearfix text-formatted field field--name-field-a11y-para-tabs-text-area field--type-text-long field--label-hidden field__item"><div class="field-inner"><p><strong>Click on the District below for detailed resources.</strong></p><hr size="0" width="100%" align="center"><p><strong>District 4 Resources:</strong></p><p><a href="https://nebraskajudicial.gov/administration/self-represented-litigant-resources/small-claims#small-claims-packet-district-4-douglas-county" data-entity-type="external"><strong>Douglas County</strong></a></p><hr size="0" width="100%" align="center"><p><a href="https://nebraskajudicial.gov/administration/self-represented-litigant-resources/small-claims#small-claims-packet-customizable" data-entity-type="external"><strong>Small Claims Packet Customizable</strong></a></p><p>&nbsp;</p></div></div>
      
