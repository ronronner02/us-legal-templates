  // The following runs on page load and adds options for layout builder to set wrapper classes supplied on child elements.
  jQuery(window).on("load", function () {
    jQuery(".page-wrapper").each(function () {
      mutationObserver.observe(this, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["class", "tabulator-cell"]
      });
    });
  });

                          
