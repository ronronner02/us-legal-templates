                                                                                                                                            <td headers="view-field-form-document-1-table-column--4" class="views-field views-field-field-form-document-1"><a href="/sites/default/files/court-forms/ccjre002.pdf">CC-JRE-002 </a>                </td>
                                                                                                                                            <td headers="view-title-table-column--4" class="views-field views-field-title">Petition for Release of Confidential Information/Order of Court                </td>
                                                                                                                                            <td headers="view-field-last-revised-table-column--4" class="views-field views-field-field-last-revised"><time datetime="2022-01-01T12:00:00Z" class="datetime">01/2022</time>
                </td>
                                                                                                                                            <td headers="view-body-table-column--4" class="views-field views-field-body"><p>Use this form if you want expungement of a juvenile record and you want to ask the court to give you information from a juvenile case.&nbsp;</p>                </td>
                    </tr>
            <tr>
                                                                                                                                            <td headers="view-field-form-document-1-table-column--4" class="views-field views-field-field-form-document-1"><a href="/sites/default/files/court-forms/ccjre003.pdf">CC-JRE-003 </a>                </td>
