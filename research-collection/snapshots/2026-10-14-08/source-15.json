    {
      "text": "Self-Help Guide",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/2024/01/SRL_Probate.pdf"
    },
    {
      "text": "Probate\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms Information guide on the who, what, when, where, how, and why in regards to probate. \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2024/01/SRL_Probate.pdf"
    },
    {
      "text": "4B-801. Proof of authority.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-801.pdf"
    },
    {
      "text": "4B-802. Certificate acknowledging receipt of documents related to proof of authority.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-802.pdf"
    },
    {
      "text": "Probate. Diné\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2024/01/Probate-2019-Navajo-FINAL.pdf"
    },
    {
      "text": "4B-304. Order for informal probate of will and appointment of personal representative (will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-304-Order-for-informal-probate-of-will-and-appointment-of-personal-representative-will.pdf"
    },
    {
      "text": "4B-307. Letters testamentary (will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-307-Letters-testamentary-will.pdf"
    },
    {
      "text": "4B-401. Notice of informal appointment of personal representative.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-401-Notice-of-informal-appointment-of-personal-representative.pdf"
    },
    {
      "text": "4B-402. Proof of notice.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-402-Proof-of-notice.pdf"
    },
    {
      "text": "4B-501. Notice to creditors by publication and notice to creditors by written notice (mailing or other delivery).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-501-Notice-to-creditors-by-publication-and-notice-to-creditors-by-written-notice-mailing-or-other-delivery.pdf"
    },
    {
      "text": "4B-601. Inventory.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-601-Inventory.pdf"
    },
    {
      "text": "4B-602. Accounting.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-602-Accounting.pdf"
    },
    {
      "text": "4B-701. Verified closing statement of the personal representative.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-701-Verified-closing-statement-of-the-personal-representative.pdf"
    },
    {
      "text": "4B-702. Verified small estate closing statement of the personal representative.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-702-Verified-small-estate-closing-statement-of-the-personal-representative.pdf"
    },
    {
      "text": "4B-904. Letters of special administration.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-904-Letters-of-special-administration.pdf"
    },
    {
      "text": "4B-902. Order appointing special administrator.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-902-Order-appointing-special-administrator.pdf"
    },
    {
      "text": "4B-903. Acceptance for appointment of special administrator.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-903-Acceptance-for-appointment-of-special-administrator.pdf"
    },
    {
      "text": "4B-1001. Order transferring case from probate court to district court.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-1001-Order-transferring-case-from-probate-court-to-district-court.pdf"
    },
    {
      "text": "4B-101. Opening and closing a probate court case (flow chart)\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-101-Opening-and-closing-a-probate-court-case-flow-chart.pdf"
    },
    {
      "text": "4B-201. Affidavit of poverty and indigency.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/forms-files/probate/"
    },
    {
      "text": "4B-202. Order allowing free process.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-202-Order-allowing-free-process.pdf"
    },
    {
      "text": "4B-301. Application for informal appointment of personal representative (no will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-301-Application-for-informal-appointment-of-personal-representative-no-will.pdf"
    },
    {
      "text": "4B-302. Application for informal probate of will and for informal appointment of personal representative (will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-302-Application-for-informal-probate-of-will-and-for-informal-appointment-of-personal-representative-will.pdf"
    },
    {
      "text": "4B-303. Order for informal appointment of personal representative (no will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/forms-files/probate/"
    },
    {
      "text": "4B-305. Acceptance of appointment as personal representative (no will) (will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-305-Acceptance-of-appointment-as-personal-representative-no-will-will.pdf"
    },
    {
      "text": "4B-306. Letters of administration (no will).\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-306-Letters-of-administration-no-will.pdf"
    },
    {
      "text": "4B-901. Application for informal appointment of special administrator.\n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t New Mexico Court Forms  \n\n\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\tView More",
      "url": "https://selfrepresentation.nmcourts.gov/wp-content/uploads/sites/62/2023/12/4B-901-Application-for-informal-appointment-of-special-administrator.pdf"
    },
